# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
# (Files generated when building packages for PyPI)
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
